{
  "name": "petal-uninstaller",
  "productName": "Petal Uninstaller",
  "version": "1.0.0",
  "description": "A Rose Pine themed Geek Uninstaller alternative: batch uninstall, force removal, leftover cleanup.",
  "main": "main.js",
  "author": "phsrp",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "assets": "node scripts/build-assets.js",
    "icon": "electron scripts/make-icon.js",
    "selftest": "set PETAL_SELFTEST=1&& electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.phsrp.petaluninstaller",
    "productName": "Petal Uninstaller",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Petal-Uninstaller-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Petal-Uninstaller-Portable-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "scan.ps1",
          "regscan.ps1",
          "clean.ps1",
          "icons.ps1"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "@fontsource/montserrat": "^5.3.0",
    "@tabler/icons": "^3.49.0"
  }
}
